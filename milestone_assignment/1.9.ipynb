   "source": [
    "num = int(input(\"Enter a number: \"))\n",
    "i = 1\n",
    "factors = []\n",
    "\n",
    "while i <= num:\n",
    "    if num % i == 0:\n",
    "        factors.append(i)\n",
    "    i += 1\n",
    "\n",
    "print(\"Factors of\", num, \"are:\", factors)\n"
   ]
  }
