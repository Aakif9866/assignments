    "color = input(\"Enter the signal color (RED/Yellow/Green): \").strip().upper()\n",
    "\n",
    "if color == \"RED\":\n",
    "    print(\"Stop\")\n",
    "elif color == \"YELLOW\":\n",
    "    print(\"Stay\")\n",
    "elif color == \"GREEN\":\n",
    "    print(\"Go\")\n",
    "else:\n",
    "    print(\"Invalid color\")\n"
