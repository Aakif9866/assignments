   "source": [
    "from flask import Flask, Blueprint\n",
    "\n",
    "bp = Blueprint('my_blueprint', __name__)\n",
    "\n",
    "@bp.route('/hello')\n",
    "def hello():\n",
    "    return \"Hello from Blueprint!\"\n",
    "\n",
    "app = Flask(__name__)\n",
    "app.register_blueprint(bp)\n",
    "\n",
    "if __name__ == '__main__':\n",
    "    app.run(debug=True)\n"
   ]
  }
 ],
